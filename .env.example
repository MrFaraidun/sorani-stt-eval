# Application Settings
STT_APP_NAME="Sorani STT Evaluator & ASO Voice Commander"
STT_LOG_LEVEL="INFO"
STT_DEVICE="cuda"
STT_DEFAULT_MODEL="openai/whisper-large-v3"
STT_MAX_AUDIO_SECONDS=600
STT_SAMPLE_RATE=16000
STT_MODELS_CACHE_DIR="./models_cache"
STT_RESULTS_PATH="./results/results.json"

# API Keys (Copy this file to .env and add your free keys)
NVIDIA_API_KEY="nvapi-your-key-here"
GEMINI_API_KEY="AIzaSy-your-key-here"
